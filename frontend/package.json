{
  "name": "iirp-v1-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/generated/api.ts",
    "check:api": "node check-api.mjs",
    "test": "node --test tests/*.test.mjs && node ../scripts/test-analysis-progress.cjs && node ../scripts/test-feed-merge.cjs"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-query": "^5.104.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
