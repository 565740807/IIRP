# Template for deploy/.env. `./iirp start` creates deploy/.env from it on first run
# (mode 600, random database password); never commit the generated file.
IIRP_DB_PASSWORD=REPLACE_WITH_PRIVATE_URL_SAFE_PASSWORD
# Optional. SEC asks automated tools for a name and a real e-mail, e.g.
# "Jane Doe jane.doe@your-mail.com". Leave empty to enter it in the web page
# instead; a value here takes precedence and is shown there as read-only.
IIRP_SEC_USER_AGENT=
